{
  "name": "solarsaathi",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "dev": "node scripts/dev.js",
    "dev:api": "node --watch apps/api/src/index.js",
    "dev:web": "vite --host 127.0.0.1",
    "build": "vite build",
    "start": "node scripts/dev.js --built",
    "check": "npm run lint",
    "lint": "eslint apps packages scripts tests *.js",
    "format": "prettier --write apps packages scripts tests *.json *.js *.md",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "db:seed": "node scripts/seed.js",
    "db:demo": "node scripts/demo-data.js",
    "db:status": "node scripts/db-status.js",
    "db:local": "node scripts/local-mongo.js",
    "db:migrate-json": "node scripts/migrate-json.js",
    "db:indexes": "node scripts/seed.js --indexes",
    "hero:frames": "node scripts/hero-frames.js"
  },
  "dependencies": {
    "@flowstack-ui/brick": "0.3.0",
    "@fontsource/fraunces": "5.1.1",
    "@fontsource/inter": "5.1.1",
    "cookie-parser": "1.4.7",
    "dotenv": "16.4.7",
    "express": "4.22.3",
    "express-rate-limit": "7.5.0",
    "helmet": "8.0.0",
    "i18next": "24.2.2",
    "jsonwebtoken": "9.0.2",
    "lucide-react": "0.468.0",
    "mongoose": "8.24.8",
    "pino": "9.6.0",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "react-i18next": "15.4.1",
    "react-router-dom": "6.30.6",
    "recharts": "2.15.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@playwright/test": "1.64.1",
    "@vitejs/plugin-react": "4.3.4",
    "eslint": "9.39.5",
    "globals": "16.0.0",
    "prettier": "3.5.3",
    "sharp": "0.35.5",
    "supertest": "7.0.0",
    "vite": "6.4.5",
    "vitest": "3.2.7"
  }
}
