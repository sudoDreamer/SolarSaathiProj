{
  "name": "solarsaathi",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "dev": "concurrently -k -n api,web -c yellow,cyan \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "tsx watch apps/api/src/index.ts",
    "dev:web": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "start": "tsx apps/api/src/index.ts --production-assets",
    "typecheck": "tsc --noEmit",
    "lint": "eslint apps packages scripts tests *.ts",
    "format": "prettier --write apps packages scripts tests *.ts *.json *.js *.md",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "db:seed": "tsx scripts/seed.ts",
    "db:demo": "tsx scripts/demo-data.ts",
    "db:status": "tsx scripts/db-status.ts",
    "db:local": "tsx scripts/local-mongo.ts",
    "db:migrate-json": "tsx scripts/migrate-json.ts",
    "db:indexes": "tsx scripts/seed.ts --indexes",
    "hero:frames": "tsx scripts/hero-frames.ts"
  },
  "dependencies": {
    "@flowstack-ui/brick": "0.3.0",
    "@fontsource/fraunces": "5.1.1",
    "@fontsource/inter": "5.1.1",
    "cookie-parser": "1.4.7",
    "dotenv": "16.4.7",
    "express": "4.21.2",
    "express-rate-limit": "7.5.0",
    "helmet": "8.0.0",
    "i18next": "24.2.2",
    "jsonwebtoken": "9.0.2",
    "lucide-react": "0.468.0",
    "mongoose": "8.10.1",
    "pino": "9.6.0",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "react-i18next": "15.4.1",
    "react-router-dom": "6.30.0",
    "recharts": "2.15.1",
    "zod": "3.24.2"
  },
  "devDependencies": {
    "@playwright/test": "1.51.1",
    "@types/cookie-parser": "1.4.8",
    "@types/express": "4.17.21",
    "@types/jsonwebtoken": "9.0.8",
    "@types/node": "22.13.5",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "@types/supertest": "6.0.2",
    "@vitejs/plugin-react": "4.3.4",
    "concurrently": "9.1.2",
    "eslint": "9.22.0",
    "prettier": "3.5.3",
    "sharp": "0.34.5",
    "supertest": "7.0.0",
    "tsx": "4.19.3",
    "typescript": "5.7.3",
    "typescript-eslint": "8.26.0",
    "vite": "6.1.0",
    "vitest": "3.0.5"
  }
}
